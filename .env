# Production Environment Variables
# Replace these values with your actual production credentials

# Backend API URL - replace with your production server
EXPO_PUBLIC_UREBOQUE_API=https://your-production-api.com

# Google Maps API Key - replace with your restricted production key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# SMS Service API Token - replace with your Releans production token
EXPO_PUBLIC_RELEANS_API_TOKEN=your_releans_api_token_here

# OTP Default for development/testing - remove in production
EXPO_PUBLIC_OTP_DEFAULT=1234

# Development override (comment out in production)
# EXPO_PUBLIC_UREBOQUE_API=http://192.168.42.6:9000