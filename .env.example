# Ureboque Client App - Environment Variables Template
# Copy this file to .env and fill in your actual values.

# API Configuration
EXPO_PUBLIC_UREBOQUE_API="https://your-production-api-url.com"
EXPO_PUBLIC_SOCKET_URL="https://your-production-api-url.com"

# Sentry Configuration (client-safe DSN)
EXPO_PUBLIC_SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"

# Centralized sanitized mobile logs
# Production default is enabled unless explicitly set to false.
EXPO_PUBLIC_REMOTE_LOGS_ENABLED="true"

# Google Maps API Key
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key-here"

# Support Contacts
EXPO_PUBLIC_SUPPORT_EMAIL="suporte@ureboque.com"
# Phone format examples: 2449XXXXXXXX or +2449XXXXXXXX
EXPO_PUBLIC_SUPPORT_WHATSAPP_PHONE=""
EXPO_PUBLIC_SUPPORT_PHONE=""

# OTP
# Mobile apps request and verify OTP through the backend.

# Image Upload Provider
# Prefer moving uploads to backend-signed uploads before production.
EXPO_PUBLIC_FREEIMAGE_API_KEY="your-freeimage-api-key-here"

# Development only. Do not set this in production builds.
EXPO_PUBLIC_OTP_DEFAULT=""
